# Weekly tournament — set these in Vercel (Project → Settings → Environment Variables).
# Without them the game runs as free play only and the tournament panel stays hidden.

# The RonkeTournament escrow (contracts/). Fees, prices, rake and split live there.
TOURNAMENT_ADDRESS=0x0000000000000000000000000000000000000000
# 2020 = Ronin mainnet · 202601 = Saigon testnet
CHAIN_ID=2020
# SYMBOL:contract:decimals[:priceToken] — which tokens the page offers. Contracts are the
# ones the casino uses, re-checked on Ronin mainnet (symbol() / decimals()). RONKE is the
# fixed-price anchor in the contract; RONKA and HORSKE are quoted at its USD value.
ENTRY_TOKENS=RONKE:0xf988f63bf26c3ed3fbf39922149e3e7b1e5c27cb:18,RONKA:0x885c4e7c864a632ce741aeba2c688b139bbbf835:18,HORSKE:0xc0ca45c2e9448d3876ca86220b2418c719298396:18
# Signs RONKA/HORSKE entry quotes; its address is set as the contract's quoter. Sensitive.
QUOTER_PRIVATE_KEY=
# 32+ random characters: openssl rand -hex 32
AUTH_SECRET=
# Optional
# RONIN_RPC_URL=https://api.roninchain.com/rpc
# CONFIRMATIONS=3
# Already set for the existing leaderboard store:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Client (build-time). Ronin Stash email login; defaults to the Privy app id the
# Ronke casino uses. Set to an empty string to hide "continue with email".
# VITE_STASH_APP_ID=
