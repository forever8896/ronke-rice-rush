# Weekly tournament — set these in Vercel (Project → Settings → Environment Variables).
# Without them the game runs as free play only and the tournament panel stays hidden.

# Wallet that receives entry fees and that you pay prizes from.
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
# SYMBOL:contract:decimals:entry-price. Contracts are the ones the Ronkeverse site uses,
# re-checked on Ronin mainnet (symbol() / decimals()) — the prices are placeholders.
ENTRY_TOKENS=RONKE:0xf988f63bf26c3ed3fbf39922149e3e7b1e5c27cb:18:1000,RONKA:0x885c4e7c864a632ce741aeba2c688b139bbbf835:18:500
# Percent of the net pool for 1st,2nd,3rd — must sum to 100.
PRIZE_SPLIT=50,30,20
# Your cut of each gross pool, whole percent (0–50).
RAKE_PERCENT=10
# 32+ random characters: openssl rand -hex 32
AUTH_SECRET=
# Optional
# RONIN_RPC_URL=https://api.roninchain.com/rpc
# CONFIRMATIONS=3
# Already set for the existing leaderboard store:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Client (build-time). Ronin Stash email login; defaults to the Privy app id the
# Ronke casino uses. Set to an empty string to hide "continue with email".
# VITE_STASH_APP_ID=
